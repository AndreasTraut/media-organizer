{
  "name": "Media Organizer - Photo Intelligence Suite",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py",
        "docs/PHASE1_PHOTO_SORT.md",
        "docs/PHASE2_PHOTO_INTELLIGENCE.md"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "python.formatting.provider": "autopep8"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  },
  
  // Installation aller Dependencies (GUI enthält bereits Phase 1 + 2)
  "updateContentCommand": "pip3 install --user -r requirements-gui.txt && echo '✅ All dependencies installed (Phase 1 + Phase 2 + GUI)'",
  
  // Streamlit automatisch starten (headless mode für Container)
  "postAttachCommand": "streamlit run app.py --server.headless true",
  
  // Port Configuration
  "portsAttributes": {
    "8501": {
      "label": "Streamlit - Media Organizer",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8501],
  
  // Features für erweiterte Funktionalität
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  }
}